{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "module": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_ENV=production node dist/src/server.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx ../../packages/db/src/seed.ts"
  },
  "dependencies": {
    "@fast-csv/parse": "^5.0.2",
    "@prisma/client": "^6.5.0",
    "@repo/db": "*",
    "@repo/shared": "*",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.3.1",
    "pino": "^8.21.0",
    "pino-pretty": "^11.0.0",
    "razorpay": "^2.9.5",
    "stripe": "^14.0.0",
    "uuid": "^9.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.8",
    "prisma": "^6.5.0",
    "tsx": "^4.19.0",
    "typescript": "7.0.2",
    "vitest": "^2.0.0"
  }
}
